$(eval $(call import.MODULE.defs,AUDIOTOOLBOXWRAPPER,audiotoolboxwrapper))
$(eval $(call import.CONTRIB.defs,AUDIOTOOLBOXWRAPPER))

AUDIOTOOLBOXWRAPPER.FETCH.url      = https://github.com/maz-1/AudioToolboxWrapper/archive/d23032360c0c6e99d2160fb833751bb36151156b.tar.gz
AUDIOTOOLBOXWRAPPER.FETCH.sha256   = 368e213e52f72dbc9406dbb9df37f594ca5297a0e6bc749b25c976a4858b5878
AUDIOTOOLBOXWRAPPER.FETCH.basename = AudioToolboxWrapper-d23032360c0c6e99d2160fb833751bb36151156b.tar.gz

AUDIOTOOLBOXWRAPPER.build_dir             = build
AUDIOTOOLBOXWRAPPER.CONFIGURE.exe         = cmake
AUDIOTOOLBOXWRAPPER.CONFIGURE.args.host   =
AUDIOTOOLBOXWRAPPER.CONFIGURE.args.build  =
AUDIOTOOLBOXWRAPPER.CONFIGURE.args.prefix = -DCMAKE_INSTALL_PREFIX="$(AUDIOTOOLBOXWRAPPER.CONFIGURE.prefix)"
AUDIOTOOLBOXWRAPPER.CONFIGURE.deps        =
AUDIOTOOLBOXWRAPPER.CONFIGURE.static      =
AUDIOTOOLBOXWRAPPER.CONFIGURE.shared      = -DBUILD_SHARED_LIBS=OFF
AUDIOTOOLBOXWRAPPER.CONFIGURE.extra       = -G "Unix Makefiles"
# The wrapper requests CMake 3.0 policies, which CMake 4 no longer supports.
AUDIOTOOLBOXWRAPPER.CONFIGURE.extra      += -DCMAKE_POLICY_VERSION_MINIMUM=3.5

ifeq (1,$(HOST.cross))
    AUDIOTOOLBOXWRAPPER.CONFIGURE.extra += -DCMAKE_SYSTEM_NAME=Windows
    AUDIOTOOLBOXWRAPPER.CONFIGURE.extra += -DCMAKE_SYSTEM_PROCESSOR=$(HOST.machine)
    AUDIOTOOLBOXWRAPPER.CONFIGURE.extra += -DCMAKE_C_COMPILER=$(AUDIOTOOLBOXWRAPPER.GCC.gcc)
    AUDIOTOOLBOXWRAPPER.CONFIGURE.extra += -DCMAKE_RC_COMPILER=$(HOST.cross.prefix)windres
endif

AUDIOTOOLBOXWRAPPER.CONFIGURE.extra += "$(call fn.ABSOLUTE,$(AUDIOTOOLBOXWRAPPER.EXTRACT.dir/))"
